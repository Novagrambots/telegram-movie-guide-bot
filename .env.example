# ==================== ОБЯЗАТЕЛЬНЫЕ ====================

# Токен бота (получить у @BotFather)
BOT_TOKEN=

# Юзернейм бота (без @) — используется в инлайн-режиме и справке
BOT_USERNAME=your_bot_username

# Ключ TMDB API v3 (получить на https://www.themoviedb.org/settings/api — бесплатно)
TMDB_API_KEY=

# Пароль к PostgreSQL (придумай любой)
DB_PASSWORD=

# Telegram ID админов через запятую (узнать у @userinfobot)
ADMIN_IDS=

# ==================== ОПЦИОНАЛЬНЫЕ ====================

ADMIN_USERNAME=admin

# Bearer token TMDB v4 (если задан, используется вместо TMDB_API_KEY)
TMDB_BEARER_TOKEN=

# Кэш данных TMDB в БД (дни)
CACHE_TTL_DAYS=7

# PostgreSQL (дефолты для docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_movies
DB_USER=bot_4_movies
